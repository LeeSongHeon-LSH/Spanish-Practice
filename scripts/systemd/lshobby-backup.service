[Unit]
Description=LSHobby DB 백업 + 복원 리허설 (pg_dump, 주 1회)
OnFailure=lshobby-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/leesongheon/projects/LSHobby
Environment=PATH=/home/leesongheon/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/leesongheon/projects/LSHobby/scripts/backup-db.sh
# 성공했을 때만 도장 — "마지막으로 잘 돈 시각"은 ~/.lshobby/last-ok/<유닛>
ExecStartPost=/bin/sh -c 'mkdir -p %h/.lshobby/last-ok && date -Is > %h/.lshobby/last-ok/%N'
